<Window x:Class="MagentaAddOnManager.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Feedback"
        Width="620" Height="640" MinWidth="520" MinHeight="520"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="12"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar, same construction as the main window -->
    <Grid Grid.Row="0" Height="50" Background="{DynamicResource WindowBrush}"
          MouseLeftButtonDown="TitleBar_MouseDown">
      <DockPanel Margin="20,0,10,0" VerticalAlignment="Center">
        <Button DockPanel.Dock="Right" Style="{StaticResource ChromeCloseButton}"
                Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
        <TextBlock Text="FEEDBACK" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="22,4,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- intro -->
        <RowDefinition Height="Auto"/>  <!-- message label -->
        <RowDefinition Height="Auto"/>  <!-- message box -->
        <RowDefinition Height="Auto"/>  <!-- report label -->
        <RowDefinition Height="*"/>     <!-- report preview -->
        <RowDefinition Height="Auto"/>  <!-- actions -->
        <RowDefinition Height="Auto"/>  <!-- address + status -->
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14">
        Found a bug, or have an idea? Tell me — it genuinely helps. The details below
        are attached automatically so I can reproduce what you saw. Nothing is sent
        until you choose to send it.
      </TextBlock>

      <TextBlock Grid.Row="1" Text="YOUR MESSAGE (OPTIONAL)" Style="{StaticResource Caption}"
                 Margin="0,0,0,6"/>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
              CornerRadius="8" Margin="0,0,0,14">
        <TextBox x:Name="MessageBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="76" Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource TextBrush}" FontSize="12"
                 CaretBrush="{DynamicResource AccentBrush}" Padding="10,8"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="MessageBox_TextChanged"/>
      </Border>

      <TextBlock Grid.Row="3" Text="WHAT GETS SENT" Style="{StaticResource Caption}"
                 Margin="0,0,0,6"/>
      <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
              CornerRadius="8" Margin="0,0,0,14">
        <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="NoWrap"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource MutedBrush}"
                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                 Padding="10,8" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
      </Border>

      <WrapPanel Grid.Row="5" Margin="0,0,0,12">
        <Button x:Name="CopyBtn" Content="Copy report" Style="{StaticResource PrimaryButton}"
                Click="Copy_Click" Margin="0,0,8,0"/>
        <Button Content="Email Alan" Style="{StaticResource SecondaryButton}"
                Click="Email_Click" Margin="0,0,8,0"/>
        <Button x:Name="GitHubBtn" Content="Open GitHub issue" Style="{StaticResource SecondaryButton}"
                Click="GitHub_Click" Visibility="Collapsed"/>
      </WrapPanel>

      <DockPanel Grid.Row="6">
        <TextBlock x:Name="StatusLine" DockPanel.Dock="Right" FontSize="11"
                   Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
        <TextBlock FontSize="11" Foreground="{DynamicResource DimBrush}"
                   VerticalAlignment="Center" TextWrapping="Wrap">
          or write to
          <Run x:Name="EmailRun" Foreground="{DynamicResource MutedBrush}"/>
        </TextBlock>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
